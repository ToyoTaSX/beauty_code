---
import ContactButtons from './ContactButtons.astro';
import Photo from './Photo.astro';
import { site } from '../lib/data';
---
<section class="hero" id="top">
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="eyebrow">{site.tagline}</p>
      <h1>Стрижки и окрашивание, <span class="accent-word">как вы хотите</span></h1>
      <p class="hero__sub text">Запишитесь по телефону или напишите мастеру в Telegram - подберём время и ответим на вопросы.</p>
      <ContactButtons />
      <dl class="hero__meta">
        <div>
          <dt class="caption">Адрес</dt>
          <dd>{site.address}</dd>
        </div>
        <div>
          <dt class="caption">Часы работы</dt>
          <dd>{site.hours.map((h) => <span class="hero__hours">{h.days}: {h.time}</span>)}</dd>
        </div>
      </dl>
    </div>
    <div class="hero__photo">
      <Photo src={site.heroPhoto} alt="Работа мастера салона: яркое окрашивание на каре" ratio="4x5" sizes="(min-width: 1280px) 1200px, 100vw" eager class="hero__img" />
    </div>
  </div>
</section>

<style>
  .hero { padding-block: var(--s5) var(--section-y); }
  .hero__grid { display: grid; gap: var(--s6); }
  .hero__text { display: grid; gap: var(--s5); align-content: center; }
  .hero__sub { color: var(--muted); }
  .hero__meta { display: grid; gap: var(--s4); }
  .hero__meta dd { font-weight: 600; }
  .hero__hours { display: block; font-variant-numeric: tabular-nums; }

  @media (min-width: 720px) {
    .hero__meta { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1080px) {
    .hero { padding-top: var(--s6); }
    .hero__grid { gap: var(--s7); }
    .hero__text { max-width: 820px; }
    .hero__photo :global(.hero__img) { aspect-ratio: 16 / 9 !important; }
  }
</style>
