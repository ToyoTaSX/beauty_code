---
// Контакты: адрес, часы, как пройти, телефон, карта 2ГИС.
// Карта (2GIS Maps API 2.0, без ключа) грузится, только когда до неё долистали.
import ContactButtons from './ContactButtons.astro';
import { site } from '../lib/data';
---
<div class="contacts">
  <dl class="contacts__info">
    <div>
      <dt class="caption">Адрес</dt>
      <dd>
        {site.address}
        <a class="contacts__route" href={site.links.twoGis} target="_blank" rel="noopener">Открыть в 2ГИС</a>
      </dd>
    </div>
    <div>
      <dt class="caption">Часы работы</dt>
      <dd>{site.hours.map((h) => <span class="contacts__hours">{h.days}: {h.time}</span>)}</dd>
    </div>
    {site.howToGet && (
      <div>
        <dt class="caption">Как пройти</dt>
        <dd>{site.howToGet}</dd>
      </div>
    )}
    <div>
      <dt class="caption">Запись</dt>
      <dd><ContactButtons /></dd>
    </div>
  </dl>

  <div
    class="contacts__map"
    data-map
    data-lat={site.map.lat}
    data-lon={site.map.lon}
    data-zoom={site.map.zoom}
    data-label={`${site.name}<br>${site.address}`}
    role="region"
    aria-label="Карта 2ГИС"
  >
    <p class="caption">
      Карта загружается.
      <a href={site.links.twoGis} target="_blank" rel="noopener">Открыть в 2ГИС</a>
    </p>
  </div>
</div>

<style>
  .contacts { display: grid; gap: var(--s6); }
  .contacts__info { display: grid; gap: var(--s5); align-content: start; }
  .contacts__info dd { font-weight: 600; }
  .contacts__info dd :global(.contact) { font-weight: 400; margin-top: var(--s2); }
  .contacts__hours { display: block; font-variant-numeric: tabular-nums; }
  .contacts__route {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 400;
  }
  .contacts__map {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    padding: var(--s5);
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-align: center;
    overflow: hidden;
  }
  .contacts__map.is-ready { padding: 0; display: block; }
  .contacts__map :global(.dg-map) { width: 100%; height: 100%; }
  /* глобальный img { max-width: 100%; height: auto } ломает тайлы и маркер */
  .contacts__map :global(.dg-map img) { max-width: none; height: revert-layer; display: revert; }

  @media (min-width: 720px) {
    .contacts__map { aspect-ratio: 3 / 2; }
  }
  @media (min-width: 1080px) {
    .contacts { grid-template-columns: 5fr 7fr; gap: var(--s7); }
  }
</style>

<script>
  type DG = {
    then(cb: () => void): void;
    map(el: HTMLElement, opts: object): object;
    marker(latlng: [number, number]): { addTo(m: object): { bindPopup(html: string): { openPopup(): void } } };
  };

  const box = document.querySelector<HTMLElement>('[data-map]');
  if (box) {
    const init = () => {
      // loader.js кладёт в window.DG заглушку и подменяет её после загрузки API,
      // поэтому настоящий DG берём внутри then.
      const getDG = () => (window as unknown as { DG: DG }).DG;
      getDG().then(() => {
        const DG = getDG();
        const { lat, lon, zoom, label } = box.dataset;
        const center: [number, number] = [Number(lat), Number(lon)];
        const el = document.createElement('div');
        el.className = 'dg-map';
        box.replaceChildren(el);
        box.classList.add('is-ready');
        const map = DG.map(el, { center, zoom: Number(zoom), fullscreenControl: false, scrollWheelZoom: false });
        DG.marker(center).addTo(map).bindPopup(label!).openPopup();
      });
    };

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const s = document.createElement('script');
        s.src = 'https://maps.api.2gis.ru/2.0/loader.js?pkg=full';
        s.async = true;
        s.onload = init;
        document.head.append(s);
      },
      { rootMargin: '300px' },
    );
    io.observe(box);
  }
</script>
