---
interface Props {
  name: 'phone' | 'telegram' | 'arrow-left' | 'arrow-right' | 'chevron' | 'close' | 'menu';
}
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name === 'phone' && (
    <path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />
  )}
  {name === 'telegram' && (
    <path d="M21 4 3 11l6 2 2 6 3-4 5 4 2-15ZM9 13l9-6-7 8" />
  )}
  {name === 'arrow-left' && <path d="M15 5l-7 7 7 7" />}
  {name === 'arrow-right' && <path d="M9 5l7 7-7 7" />}
  {name === 'chevron' && <path d="M6 9l6 6 6-6" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
</svg>
